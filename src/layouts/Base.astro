---
import { getImage } from 'astro:assets';
import appIcon from '../assets/images/app-icon.png';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { app } from '../data/site';
import '../styles/site.css';

interface Props {
  title: string;
  description: string;
  // Path of the page with leading and trailing slash, e.g. "/privacy/".
  path: string;
  noindex?: boolean;
}

const { title, description, path, noindex = false } = Astro.props;

const canonical = new URL(path, Astro.site).href;
const socialImage = new URL('/images/screenshots/mac-03-popular.jpg', Astro.site).href;

// PNG on purpose: getImage would produce WebP by default.
const favicon = await getImage({ src: appIcon, width: 64, height: 64, format: 'png' });
const touchIcon = await getImage({ src: appIcon, width: 180, height: 180, format: 'png' });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={app.author} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/png" href={favicon.src} />
    <link rel="apple-touch-icon" href={touchIcon.src} />
    <meta property="og:site_name" content={app.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:domain" content={Astro.site?.hostname} />
    <meta name="twitter:dnt" content="on" />
    <meta name="apple-itunes-app" content={`app-id=${app.appStoreId}`} />
  </head>
  <body>
    <Header />
    <main class="site-main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

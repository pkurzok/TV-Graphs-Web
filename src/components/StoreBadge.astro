---
import { app } from '../data/site';

const badge = app.badge[app.status];
---

<a href={app.appStoreUrl} class="store-badge-link">
  <img src={`/images/${badge.file}-black.svg`} alt={badge.alt} class="store-badge store-badge-light-mode" />
  <img src={`/images/${badge.file}-white.svg`} alt={badge.alt} class="store-badge store-badge-dark-mode" />
</a>
